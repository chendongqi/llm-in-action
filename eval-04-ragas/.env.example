# ============================================
# LLM 配置（用于 RAG 生成 + RAGAS Judge）
# ============================================
LLM_API_KEY=your-zhipu-api-key-here

# ============================================
# Embedding 模型配置（用于向量检索）
# SiliconFlow OpenAI 兼容接口（推荐）
# ============================================
EMBEDDING_API_KEY=your-siliconflow-api-key-here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- 可替换为 OpenAI Embedding ---
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxx
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# LLM 配置（用于 Agent + DeepEval Judge LLM）
# ============================================
LLM_API_KEY=your-zhipu-api-key-here

# 注意：DeepEval 默认需要 OPENAI_API_KEY
# 本 demo 通过自定义 GlmFlashEval 类绕过，
# 只需设置上面的 LLM_API_KEY 即可。

# --- 可替换为 OpenAI（无需自定义类）---
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# 将 demo 中的 judge_llm = GlmFlashEval() 改为
# judge_llm = None（DeepEval 会自动使用 OPENAI_API_KEY）

  <data key="d0">entity</data>
  <data key="d3">"FUNCTION"</data>
  <data key="d4">"It provides `get_doc_by_file_basename` for basename direct lookup.</data>
  <data key="d2">chunk-02c5bff8f2fe6a621cc9a6ced39ccfaf</data>
</node>

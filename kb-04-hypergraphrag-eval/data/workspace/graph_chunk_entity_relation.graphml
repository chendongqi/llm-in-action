<edge source="&lt;hyperedge&gt;&quot;Create `docker-compose.yaml` in the `docling` directory from the previous step, with the following contents:&quot;" target="&quot;DOCKER-COMPOSE.YAML CONTENTS&quot;">
  <data key="d5">85.0</data>

  <data key="d2">chunk-c0ff5c99c56fa54fe27e56cb06863931&lt;SEP&gt;chunk-58732a4b6a97c3eeba3cb6d1206d401e</data>
</node>
<node id="&lt;hyperedge&gt;&quot;LightRAG supports these embedding backends: lollms, ollama, openai or openai compatible, azure_openai, bedrock, jina, gemini, voyageai&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">5.0</data>

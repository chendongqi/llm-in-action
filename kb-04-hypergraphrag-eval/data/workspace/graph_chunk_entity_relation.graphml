  <data key="d0">entity</data>
  <data key="d3">"OBJECT"</data>
  <data key="d4">"Unmerged chunk has only one element in `sidecar.refs`. "</data>
  <data key="d2">chunk-a79bee86d871fa85d9e457899f3ff418</data>
</node>

  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-dfdc14720aca7f1c8740b02182c2b4d8</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The legacy `[表格片段N]` suffix has been unified under `[part n]`. &quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">7.0</data>
  <data key="d2">chunk-f62767a155c127d2e19bb2a763d570c3</data>
</node>
<node id="&lt;hyperedge&gt;&quot;| `none` | A non-table slice or an unsplit whole table | Handled as an ordinary text chunk |&quot;">
  <data key="d0">hyperedge</data>

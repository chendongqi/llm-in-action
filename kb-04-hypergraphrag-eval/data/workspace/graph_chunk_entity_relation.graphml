</edge>
<edge source="&lt;hyperedge&gt;&quot;To let the P chunking strategy split body text without breaking multimodal objects, three XML-style placeholder tags are used inside `content` &quot;" target="&quot;P CHUNKING STRATEGY&quot;">
  <data key="d5">140.0</data>
  <data key="d6">chunk-a79bee86d871fa85d9e457899f3ff418</data>
</edge>

<edge source="&lt;hyperedge&gt;&quot;The text embedding step generates embeddings for entities, text units, and community reports, which are then stored in a vector store for downstream vector search.&quot;" target="&quot;TEXT EMBEDDING &quot;">
  <data key="d5">90.0</data>
  <data key="d6">chunk-1510fdc0a4611e7ac84d55abc79e6e54</data>

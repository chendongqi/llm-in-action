  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"The P strategy avoids cross-topic pollution by fully exploiting heading levels and table-row boundaries, and chunk boundaries hug semantics most closely."&lt;SEP&gt;"The effect avoids lumping together small blocks from different topics.</data>
  <data key="d2">chunk-c57c83519f50b4e9e94ec0fa78d3401a&lt;SEP&gt;chunk-d5becb2ed078b428ad8287c1f5c91acf</data>
</node>

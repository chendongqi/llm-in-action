</node>
<node id="&lt;hyperedge&gt;&quot;| Mistral Embed | `mistral-embed` | Use the provider's plain embedding input. Do not invent task prefixes. &quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">9.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>
<node id="&lt;hyperedge&gt;&quot;Do not reuse an existing vector store across asymmetric embedding configuration changes. Mixing vectors generated with different query/document behavior can make retrieval quality unpredictable.&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>
<node id="&lt;hyperedge&gt;&quot;Do not use an empty environment value for an intentional empty prefix:">
  <data key="d0">hyperedge</data>
  <data key="d1">14.0</data>
  <data key="d2">chunk-b365e355f26b9e2eac9eff4198039b0c</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The same is true when the flag is explicitly false: &quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">17.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>

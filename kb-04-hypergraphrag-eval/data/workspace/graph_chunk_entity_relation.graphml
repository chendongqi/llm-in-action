<node id="&quot;CANONICAL_BASENAME&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"Internally comparing against the `canonical_basename` field.&lt;SEP&gt;"LightRAG mandates `canonical_basename` uniqueness within the same workspace to avoid conflicts."&lt;SEP&gt;"LightRAG requires `canonical_basename` uniqueness within the workspace to ensure concurrency safety."</data>
  <data key="d2">chunk-02c5bff8f2fe6a621cc9a6ced39ccfaf&lt;SEP&gt;chunk-8a332187a994e8a8bda343951839585b&lt;SEP&gt;chunk-59fa2d582eb20bc136094483fb09d31c</data>
</node>

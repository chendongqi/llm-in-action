</node>
<node id="&quot;WEB UI&quot;">
  <data key="d0">entity</data>
  <data key="d3">"INTERFACE"</data>
  <data key="d4">"The LightRAG Server is designed to provide a Web UI and API support."&lt;SEP&gt;"The Web UI facilitates document indexing, knowledge graph exploration, and a simple RAG query interface."</data>
  <data key="d2">chunk-8286dc1e92acbe46895a3e4b4adbe05d</data>
</node>
<node id="&quot;KEYWORD&quot;">
  <data key="d0">entity</data>
  <data key="d3">"ROLE"</data>
  <data key="d4">"KEYWORD role uses Qwen3.5-35B-A3B deployed by local vLLM.&lt;SEP&gt;"Query keyword generation before retrieval."&lt;SEP&gt;"Query-stage keyword extraction for high-level/low-level keyword generation before retrieval. An ultra-fast model with thinking mode disabled is recommended."</data>
  <data key="d2">chunk-082eb07a755d44999510e8f240806102&lt;SEP&gt;chunk-2222a5f74e1118344a0513e7d693837a&lt;SEP&gt;chunk-280dedf626baee86fc0d61cdd836e6ac</data>
</node>

  <data key="d0">entity</data>
  <data key="d3">"CODE"</data>
  <data key="d4">"This checks if the table is identified as `&lt;table format="json"&gt;` in `.blocks.jsonl`."</data>
  <data key="d2">chunk-1f6e0884f12ea67e008e26e0216f0a4e</data>
</node>

<edge source="&lt;hyperedge&gt;&quot;The `content` field is the raw LaTeX (possibly containing Unicode operators, outer `\[ \]`); does not include the leading/trailing `$` delimiters; read directly by the modal analysis stage &quot;" target="&quot;CONTENT FIELD&quot;">
  <data key="d5">80.0</data>
  <data key="d6">chunk-473420f06d48aa17cce8e74c7be782ac</data>
</edge>

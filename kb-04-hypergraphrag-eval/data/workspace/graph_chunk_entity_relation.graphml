  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>
<node id="&lt;hyperedge&gt;&quot;Before enabling asymmetric embeddings for any model, check the model's current model card or provider documentation. Do not infer the right behavior from the API binding alone: an `openai`-compatible endpoint can serve instruction-free models, prefix-based models, or provider-specific models behind the same API shape.&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">9.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>

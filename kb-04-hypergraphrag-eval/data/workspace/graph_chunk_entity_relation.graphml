  <data key="d2">chunk-0457e4c69abfc4709a265a8f9f349adb</data>
</node>
<node id="&lt;hyperedge&gt;&quot;`table_header` | Optional reserved field; when the current block is a table slice, this holds the recognized table header. Currently unused. &quot;">
  <data key="d0">hyperedge</data>

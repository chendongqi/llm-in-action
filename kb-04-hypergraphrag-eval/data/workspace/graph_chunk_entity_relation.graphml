  <data key="d2">chunk-33d111aa7def535c2ef43b93f5b747d7</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The empty string is displayed as `n/a` in the assembled prompt to indicate the absence of surrounding content.">
  <data key="d0">hyperedge</data>
  <data key="d1">6.0</data>
  <data key="d2">chunk-0457e4c69abfc4709a265a8f9f349adb</data>
</node>
<node id="&lt;hyperedge&gt;&quot;This document describes the **LightRAG Sidecar** file format that content parsing engines output.&quot;">
  <data key="d0">hyperedge</data>

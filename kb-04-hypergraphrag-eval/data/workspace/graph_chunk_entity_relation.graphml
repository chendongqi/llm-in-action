  <data key="d0">entity</data>
  <data key="d3">"CODE"</data>
  <data key="d4">"This checks for a legacy `[表格片段N]` suffix indicating data output by an old chunker version, prompting re-chunking with the new `[part n]` scheme."</data>
  <data key="d2">chunk-1f6e0884f12ea67e008e26e0216f0a4e</data>
</node>
<node id="&quot;EFFECT SERVED&quot;">

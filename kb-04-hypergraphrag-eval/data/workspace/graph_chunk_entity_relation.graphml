</node>
<node id="&lt;hyperedge&gt;&quot;The API key is passed using the request header `X-API-Key`. Below is an example of accessing the LightRAG Server via API:">
  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-e07113c82d8f800d43e240dceb9a4230</data>
</node>
<node id="&lt;hyperedge&gt;&quot;LIGHTRAG_PARSER=*:native-teP,*:legacy-R&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">19.0</data>
  <data key="d2">chunk-58732a4b6a97c3eeba3cb6d1206d401e&lt;SEP&gt;chunk-d7149569405d52b329c2d9c690f051dd</data>
</node>
<node id="&lt;hyperedge&gt;&quot;* Account credentials (the Web UI requires login before access can be granted):&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">16.0</data>
  <data key="d2">chunk-e07113c82d8f800d43e240dceb9a4230</data>
</node>
<node id="&lt;hyperedge&gt;&quot;# CHUNK_R_SEPARATORS=[&quot;\n\n&quot;,&quot;\n&quot;,&quot;。&quot;,&quot;！&quot;,&quot;？&quot;,&quot;；&quot;,&quot;，&quot;,&quot; &quot;,&quot;&quot;]&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">12.0</data>
  <data key="d2">chunk-58732a4b6a97c3eeba3cb6d1206d401e</data>
</node>
<node id="&lt;hyperedge&gt;&quot;LightRAG API Server implements JWT-based authentication using the HS256 algorithm. To enable secure access control, the following environment variables are required:">
  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-e07113c82d8f800d43e240dceb9a4230</data>
</node>
<node id="&lt;hyperedge&gt;&quot;# CHUNK_P_SIZE=2000&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">12.0</data>
  <data key="d2">chunk-58732a4b6a97c3eeba3cb6d1206d401e</data>
</node>
<node id="&lt;hyperedge&gt;&quot;AUTH_ACCOUNTS='admin:{bcrypt}$2b$12$replace-with-generated-hash,user1:pass456'">
  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-e07113c82d8f800d43e240dceb9a4230</data>
</node>

  <data key="d0">hyperedge</data>
  <data key="d1">16.0</data>
  <data key="d2">chunk-8286dc1e92acbe46895a3e4b4adbe05d</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The snippets below intentionally show only the values that matter for each step.&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">7.0</data>
  <data key="d2">chunk-d7149569405d52b329c2d9c690f051dd</data>
</node>
<node id="&lt;hyperedge&gt;&quot;MINERU_IS_OCR=false&quot;">
  <data key="d0">hyperedge</data>

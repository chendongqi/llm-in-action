  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"graphml is a standard file format supported by many visualization tools."&lt;SEP&gt;"graphml is a standard file format used to represent graphs.</data>
  <data key="d2">chunk-753b54f11987ea184b7a7af0bb9e15ee</data>
</node>
<node id="&quot;RECOMMENDATION&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>

  <data key="d2">chunk-8a332187a994e8a8bda343951839585b</data>
</node>
<node id="&lt;hyperedge&gt;&quot;1. A `_reserve_enqueue_slot` → `pending_enqueues=1`, write file, schedule bg task A, return success.">
  <data key="d0">hyperedge</data>

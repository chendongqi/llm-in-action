  <data key="d0">entity</data>
  <data key="d3">"RESOURCE"</data>
  <data key="d4">"The configuration documentation provides details on how to change the prompts.</data>
  <data key="d2">chunk-15ee7c6b211b6ac87701bf817a50f7cb</data>
</node>

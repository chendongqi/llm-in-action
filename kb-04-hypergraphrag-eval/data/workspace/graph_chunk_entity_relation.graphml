  <data key="d2">chunk-f6cea8687c979b2611fc1fbab8d9e8b2</data>
</node>
<node id="&quot;OVERLAP SETTINGS&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"Overlap settings determine how much of the text overlaps between consecutive chunks, which can affect the continuity of information across chunks."</data>
  <data key="d2">chunk-f245702d4300114f106e260ea1773771</data>
</node>
<node id="&quot;HTTP 409 ON UPLOAD/ENQUEUE&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"HTTP 409 is returned on upload/enqueue if `canonical_basename` uniqueness is violated, ensuring concurrency safety."</data>
  <data key="d2">chunk-8a332187a994e8a8bda343951839585b</data>
</node>

<edge source="&quot;FORMAT&quot;" target="&lt;hyperedge&gt;&quot;This text provides a table of information about document management metadata for a technical document. It lists various fields such as `id`, `blockid`, `heading`, `parent_headings`, `dimension`, `format`, `content`, `caption`, `footnotes`, `surrounding`, `self_ref`, and `extras`.&quot;">
  <data key="d5">80.0</data>
  <data key="d6">chunk-6df28f5232d5c31b9f64164c61a08e65</data>
</edge>

</node>
<node id="&lt;hyperedge&gt;&quot;This avoids accidental retrieval changes when prefix variables are present in an environment but the user did not intentionally enable asymmetric embeddings.&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">7.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>

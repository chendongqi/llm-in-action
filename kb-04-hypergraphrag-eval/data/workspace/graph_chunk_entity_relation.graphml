<node id="&quot;PYTHON -C &quot;FROM LIGHRAG.UTILS IMPORT TIKTOKENTOKENIZER; T = TIKTOKENTOKENIZER(); PRINT('✓ TIKTOKEN WORKING')&quot; &quot;">
  <data key="d0">entity</data>
  <data key="d3">" COMMAND "</data>
  <data key="d4">" python -c "from lighrag.utils import TiktokenTokenizer; t = TiktokenTokenizer(); print('✓ Tiktoken working')" verifies the Tiktoken tokenizer.</data>

  <data key="d6">chunk-1f6e0884f12ea67e008e26e0216f0a4e</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;A table of unrecognized format can only go through character splitting and cannot start TableRowSplit's role mechanism.&quot;" target="&quot;CHARACTER SPLITTING&quot;">

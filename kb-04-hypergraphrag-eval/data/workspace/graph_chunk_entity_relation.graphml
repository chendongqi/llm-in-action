  <data key="d3">"OBJECT"</data>
  <data key="d4">"The main block's heading is kept after merging.</data>
  <data key="d2">chunk-b84c6dc4e56f32ef79bfc21440cf2ef4</data>
</node>
<node id="&quot;UNRELATED BODY TEXT&quot;">
  <data key="d0">entity</data>
  <data key="d3">"OBJECT"</data>
  <data key="d4">"The `middle` role is emitted standalone, avoiding merger with unrelated body text."&lt;SEP&gt;"The `middle` role's table slice is emitted standalone to avoid merging with unrelated body text."</data>
  <data key="d2">chunk-0a78f97cbe007105c80acba2db42453d</data>
</node>
<node id="&quot;PARAGRAPH_SEMANTIC ... FALLBACK TO RECURSIVE_CHARACTER&quot;">
  <data key="d0">entity</data>
  <data key="d3">"LOG ENTRY"</data>
  <data key="d4">"This checks for specific log entries indicating fallback to recursive_character."</data>
  <data key="d2">chunk-1f6e0884f12ea67e008e26e0216f0a4e</data>
</node>
<node id="&quot;PART SUFFIX&quot;">
  <data key="d0">entity</data>
  <data key="d3">"OBJECT"</data>
  <data key="d4">"The final heading keeps the main block's part suffix.</data>
  <data key="d2">chunk-b84c6dc4e56f32ef79bfc21440cf2ef4</data>
</node>
<node id="&quot;CHUNK BOUNDARIES&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"The P strategy aligns chunk boundaries with the document's native semantic boundaries as much as possible."&lt;SEP&gt;"The core goal of the P strategy is to align chunk boundaries with the document's native semantic boundaries as much as possible."</data>
  <data key="d2">chunk-c57c83519f50b4e9e94ec0fa78d3401a</data>
</node>

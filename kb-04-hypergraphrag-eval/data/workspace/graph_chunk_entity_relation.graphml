</node>
<node id="&quot;EXTRACT&quot;">
  <data key="d0">entity</data>
  <data key="d3">"ROLE"</data>
  <data key="d4">"EXTRACT role uses the OpenAI official API, gpt-5-mini.&lt;SEP&gt;"Entity/relation extraction and merge summaries."&lt;SEP&gt;"The model used during the file insertion stage, mainly for complex entity/relation extraction and summarization. A fast model with thinking mode disabled is recommended."</data>
  <data key="d2">chunk-082eb07a755d44999510e8f240806102&lt;SEP&gt;chunk-2222a5f74e1118344a0513e7d693837a&lt;SEP&gt;chunk-280dedf626baee86fc0d61cdd836e6ac</data>
</node>

  <data key="d0">hyperedge</data>
  <data key="d1">17.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>
<node id="&lt;hyperedge&gt;&quot;| Instruction-free model such as `BAAI/bge-m3`, `text-embedding-3-small`, `mistral-embed`, base GTE, or Jina v2 | Keep symmetric mode; do not configure prefixes or provider tasks unless the model card says to. |&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">7.0</data>
  <data key="d2">chunk-b365e355f26b9e2eac9eff4198039b0c</data>
</node>
<node id="&lt;hyperedge&gt;&quot;Use this mode for providers that expose separate query/document embedding tasks. Do not configure prefix variables for these bindings. &quot;">

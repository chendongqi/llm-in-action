  <data key="d0">entity</data>
  <data key="d3">"CODE"</data>
  <data key="d4">"The path for `lightrag_document_path` is checked for the existence and non-emptiness of the `.blocks.jsonl` file."</data>
  <data key="d2">chunk-1f6e0884f12ea67e008e26e0216f0a4e</data>
</node>
<node id="&quot;MAIN BLOCK'S HEADING&quot;">

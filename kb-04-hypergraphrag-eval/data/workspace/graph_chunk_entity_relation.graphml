  <data key="d2">chunk-8cedc79909a2121d28e3444802703cf3</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The text specifies that the default settings do not include literal matching of English punctuation marks, which is done to prevent mis-splitting of numbers and abbreviations in text.&quot;&quot;">
  <data key="d0">hyperedge</data>

  <data key="d6">chunk-33d111aa7def535c2ef43b93f5b747d7</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;`blocks` | `int` | Number of content lines (excluding meta) &quot;" target="&quot;BLOCKS&quot;">

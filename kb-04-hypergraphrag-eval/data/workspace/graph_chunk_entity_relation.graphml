</node>
<node id="&lt;hyperedge&gt;&quot;When the text is fed to the LLM during entity/relation extraction, internal attributes such as `id / path / src` are stripped, but key attributes (`format / caption`) are preserved. &quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">14.0</data>
  <data key="d2">chunk-a79bee86d871fa85d9e457899f3ff418</data>
</node>

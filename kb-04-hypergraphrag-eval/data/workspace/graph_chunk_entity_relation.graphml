  <data key="d2">chunk-8a332187a994e8a8bda343951839585b</data>
</node>
<node id="&quot;FILE ENQUEUE AND EXTRACTION RESULTS ARE WRITTEN INTO `FULL_DOCS`&quot;">
  <data key="d0">entity</data>
  <data key="d3">"DESCRIPTION"</data>
  <data key="d4">"Storage and Directory Layout describes where file enqueue and extraction results are stored.</data>
  <data key="d2">chunk-821452c2e57f78506ae365dc36678fcb</data>
</node>
<node id="&quot;ENQUEUES THE CURRENT FILE AS A NEW FILE&quot;">
  <data key="d0">entity</data>
  <data key="d3">"ACTION"</data>
  <data key="d4">"The current file is enqueued as a new file for processing after the stub is deleted.</data>
  <data key="d2">chunk-59fa2d582eb20bc136094483fb09d31c</data>

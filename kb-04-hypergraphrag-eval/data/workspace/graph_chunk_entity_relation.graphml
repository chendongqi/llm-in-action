  <data key="d2">chunk-eefa10d662229bd1054dbd21eaf6d102</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The ASGI middleware in `create_app` ensures that routes resolve correctly under both forwarding styles by prepending `root_path` to `scope[&quot;path&quot;]` when necessary.">
  <data key="d0">hyperedge</data>
  <data key="d1">9.0</data>

  <data key="d0">entity</data>
  <data key="d3">"OBJECT"</data>
  <data key="d4">"JsonDocStatusStorage uses workspace subdirectories for data isolation."&lt;SEP&gt;"`JsonDocStatusStorage` already implements an in-memory traversal.</data>

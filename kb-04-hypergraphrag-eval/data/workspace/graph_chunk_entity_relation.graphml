  <data key="d0">entity</data>
  <data key="d3">"DATABASE"</data>
  <data key="d4">"An external endpoint that supports Atlas is required for MONGO_URI.&lt;SEP&gt;"For non-wizard-managed services, an external Atlas-capable MongoDB endpoint is required.</data>
  <data key="d2">chunk-2e8030e636243c7d9ef84975499293ce</data>
</node>

<edge source="&lt;hyperedge&gt;&quot;The `CHUNK_SIZE` environment variable is the legacy top-level chunk_token_size fallback for the chunker parameter settings.&quot;" target="&quot;CHUNK_TOKEN_SIZE&quot;">
  <data key="d5">85.0</data>
  <data key="d6">chunk-f245702d4300114f106e260ea1773771</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;The `CHUNK_SIZE` environment variable is the legacy top-level chunk_token_size fallback for the chunker parameter settings.&quot;" target="&quot;CHUNK_SIZE ENVIRONMENT VARIABLE&quot;">

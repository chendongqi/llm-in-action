  <data key="d0">entity</data>
  <data key="d3">"OBJECT"</data>
  <data key="d4">"API can be created using Azure CLI commands."&lt;SEP&gt;"An API can be created using Azure CLI commands."&lt;SEP&gt;"mineru-api container uses the api profile.&lt;SEP&gt;"mineru-api includes profile api."</data>
  <data key="d2">chunk-0a5f058377b951c53da07f784f3944ef&lt;SEP&gt;chunk-8cedc79909a2121d28e3444802703cf3</data>

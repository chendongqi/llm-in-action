</node>
<node id="&lt;hyperedge&gt;&quot;LightRAG keeps embedding behavior symmetric by default. Query/document asymmetric embedding is enabled only when `EMBEDDING_ASYMMETRIC=true` is explicitly set.&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>

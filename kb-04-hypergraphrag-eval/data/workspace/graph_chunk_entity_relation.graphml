<edge source="&lt;hyperedge&gt;&quot;- relationships.parquet - this is the list of relationships found in the dataset, which are the edges of the graph.&quot;" target="&quot;RELATIONSHIPS.PARQUET&quot;">
  <data key="d5">85.0</data>

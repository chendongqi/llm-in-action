  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>
<node id="&lt;hyperedge&gt;&quot;When `EMBEDDING_ASYMMETRIC` is unset, LightRAG does not enable asymmetric embedding behavior, even if prefix variables exist: &quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">25.0</data>
  <data key="d2">chunk-cd74b84904f076da611686fd7750bdea</data>
</node>

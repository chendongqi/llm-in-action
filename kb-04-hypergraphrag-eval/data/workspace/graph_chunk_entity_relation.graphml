</node>
<node id="&lt;hyperedge&gt;&quot;LightRAG supports these LLM backends: ollama, lollms, openai or openai compatible, azure_openai, bedrock, gemini&quot;">
  <data key="d0">hyperedge</data>
  <data key="d1">5.0</data>
  <data key="d2">chunk-8286dc1e92acbe46895a3e4b4adbe05d</data>
</node>

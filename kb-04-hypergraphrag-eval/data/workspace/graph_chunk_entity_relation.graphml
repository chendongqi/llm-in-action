  <data key="d2">chunk-33d111aa7def535c2ef43b93f5b747d7</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The `range` field in paraid specifies the start and end paragraph IDs, and optionally the `charspan` can indicate the character range of the content.">
  <data key="d0">hyperedge</data>

  <data key="d6">chunk-dfdc14720aca7f1c8740b02182c2b4d8</data>
</edge>
<edge source="&quot;CHUNK&quot;" target="&lt;hyperedge&gt;&quot;Every rule of the P strategy serves one goal: **align chunk boundaries with the document's native semantic boundaries, and make each chunk understandable on its own at recall time**.">
  <data key="d5">90.0</data>
  <data key="d6">chunk-dfdc14720aca7f1c8740b02182c2b4d8</data>
</edge>
<edge source="&quot;CHUNK&quot;" target="&lt;hyperedge&gt;&quot;Every rule of the P strategy serves one goal: align chunk boundaries with the document's native semantic boundaries, and make each chunk understandable on its own at recall time.">

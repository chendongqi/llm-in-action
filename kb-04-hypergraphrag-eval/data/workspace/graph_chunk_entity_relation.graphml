  <data key="d6">chunk-e07113c82d8f800d43e240dceb9a4230</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;Asymmetric embedding is explicit opt-in. Set `EMBEDDING_ASYMMETRIC=true` only when the selected embedding backend supports either provider task parameters or task prefixes. See [Asymmetric Embedding Configuration](./AsymmetricEmbedding.md) before changing these settings, because existing data must be cleared and files re-indexed after any change:" target="&quot;TASK PREFIXES&quot;">
  <data key="d5">160.0</data>
  <data key="d6">chunk-0a5f058377b951c53da07f784f3944ef</data>
</edge>

<node id="&quot;RESOLUTION CHAIN&quot;">
  <data key="d0">entity</data>
  <data key="d3">"CONCEPT"</data>
  <data key="d4">"P's chunk_token_size resolution does not follow the full four-tier chain."</data>
  <data key="d2">chunk-8270352cccb49b2bcd5b1d3ab329e22b</data>
</node>
<node id="&quot;CHUNK_OL&quot;">
  <data key="d0">entity</data>
  <data key="d3">"PARAMETER"</data>

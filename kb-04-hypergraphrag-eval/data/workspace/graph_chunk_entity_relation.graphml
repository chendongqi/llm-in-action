</edge>
<edge source="&quot;DOCLING&quot;" target="&lt;hyperedge&gt;&quot;The original file is moved into the sibling `__parsed__` directory; `native` / `mineru` / `docling` keep the original file first for the pipeline to parse, and only move it to `__parsed__` after successful parsing and writing to `full_docs`.&quot;">
  <data key="d5">60.0</data>
  <data key="d6">chunk-f6cea8687c979b2611fc1fbab8d9e8b2</data>
</edge>
<edge source="&quot;DOCLING&quot;" target="&lt;hyperedge&gt;&quot;slides.[docling].pptx&quot;">
  <data key="d5">80.0</data>

  <data key="d3">"PROCESS"</data>
  <data key="d4">"Background task B calls apipeline_process_enqueue_documents and sets request_pending.&lt;SEP&gt;"Background task B writes normally and sets request_pending after writing.</data>
  <data key="d2">chunk-5b23b4175c6c0f4dc09cf75abdbc8b03</data>
</node>

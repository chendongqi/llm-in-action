  <data key="d2">chunk-59fa2d582eb20bc136094483fb09d31c</data>
</node>
<node id="&quot;MINERU-LIGHTRAG.JSON&quot;">
  <data key="d0">entity</data>
  <data key="d3">"VOLUME"</data>
  <data key="d4">"The `mineru-lightrag.json` file is modified to enable the title-level correction feature."&lt;SEP&gt;"The volume ./mineru-lightrag.json is mounted to /root/mineru-lightrag.json in mineru-api.&lt;SEP&gt;"mineru-lightrag.json is mounted from ./ to /root/mineru-lightrag.json in mineru-api.</data>
  <data key="d2">chunk-329eac639a865519f1557ce9dc303a63&lt;SEP&gt;chunk-8cedc79909a2121d28e3444802703cf3</data>
</node>

<edge source="&lt;hyperedge&gt;&quot;- `Covariate` - Extracted claim information, which contains statements about entities which may be time-bound.&quot;" target="&quot;COVARIATE&quot;">
  <data key="d5">170.0</data>
  <data key="d6">chunk-7e8c003efcd580037bb1cdeb5a33b78f</data>

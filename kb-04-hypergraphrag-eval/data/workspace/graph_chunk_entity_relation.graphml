  <data key="d0">hyperedge</data>
  <data key="d1">8.0</data>
  <data key="d2">chunk-8cedc79909a2121d28e3444802703cf3</data>
</node>
<node id="&lt;hyperedge&gt;&quot;The text indicates that the `chunk_token_size` for the V strategy is a hard cap, and if exceeded, the text will be automatically re-split through the R strategy.&quot;">
  <data key="d0">hyperedge</data>

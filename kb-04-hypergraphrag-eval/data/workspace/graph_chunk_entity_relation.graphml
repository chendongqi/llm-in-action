</edge>
<edge source="&quot;P CHUNKING STRATEGY&quot;" target="&lt;hyperedge&gt;&quot;The configuration specifies the use of native, mineru, and docling parsers for different file formats, with P as the common chunking strategy.">
  <data key="d5">70.0</data>
  <data key="d6">chunk-a157ba8bb77c0492f14d1d2322564184</data>
</edge>

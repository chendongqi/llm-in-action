</node>
<node id="&lt;hyperedge&gt;&quot;Max tokens value can be calculated by this formula: `LLM_TIMEOUT * llm_output_tokens/second` (i.e. `240s * 50 tokens/s = 12000`, max_tokens should smaller than 12000)&quot;">
  <data key="d0">hyperedge</data>

<edge source="&lt;hyperedge&gt;&quot;Several users have asked if they can bring their own existing graph and have it summarized for query with GraphRAG.&quot;" target="&quot;EXISTING GRAPH&quot;">
  <data key="d5">85.0</data>
  <data key="d6">chunk-04e9a4e23946a2a3618f112c8e332247</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;There are many possible ways to do this, but here we'll describe a simple method that aligns with the existing GraphRAG workflows quite easily.&quot;" target="&quot;SIMPLE METHOD&quot;">
  <data key="d5">85.0</data>
  <data key="d6">chunk-04e9a4e23946a2a3618f112c8e332247</data>
</edge>

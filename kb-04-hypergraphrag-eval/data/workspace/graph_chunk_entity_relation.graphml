  <data key="d6">chunk-0a5f058377b951c53da07f784f3944ef</data>
</edge>
<edge source="&quot;SYSTEM ENVIRONMENT VARIABLES&quot;" target="&lt;hyperedge&gt;&quot;These variables have higher precedence over system environment variables when the server starts.&quot;">
  <data key="d5">90.0</data>
  <data key="d6">chunk-d7149569405d52b329c2d9c690f051dd</data>
</edge>
<edge source="&quot;SYSTEM ENVIRONMENT VARIABLES&quot;" target="&lt;hyperedge&gt;&quot;The configurations in `.env` files are loaded into the system environment variables on server start.">
  <data key="d5">90.0</data>
  <data key="d6">chunk-d7149569405d52b329c2d9c690f051dd</data>
</edge>
<edge source="&quot;SYSTEM ENVIRONMENT VARIABLES&quot;" target="&lt;hyperedge&gt;&quot;It is important to note that the LightRAG Server will load the environment variables from `.env` into the system environment variables each time it starts. **LightRAG Server will prioritize the settings in the system environment variables to .env file**.">
  <data key="d5">85.0</data>
  <data key="d6">chunk-021f97620f79cb0c99aad301145dfec1</data>
</edge>

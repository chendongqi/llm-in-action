  <data key="d2">chunk-8a332187a994e8a8bda343951839585b</data>
</node>
<node id="&quot;PARAGRAPH_SEMANTIC&quot;">
  <data key="d0">entity</data>
  <data key="d3">"LOG"</data>
  <data key="d4">"Selector maps to `paragraph_semantic` chunker strategy.&lt;SEP&gt;"paragraph_semantic is a chunker strategy in the `addon_params["chunker"]` full baseline.&lt;SEP&gt;"This is a log keyword for module entry, used in troubleshooting."</data>
  <data key="d2">chunk-1f6e0884f12ea67e008e26e0216f0a4e&lt;SEP&gt;chunk-821452c2e57f78506ae365dc36678fcb</data>

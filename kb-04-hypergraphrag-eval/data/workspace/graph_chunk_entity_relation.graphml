  <data key="d6">chunk-44dde1b8fa9d74e9edbda4a6a1d22019</data>
</edge>
<edge source="&lt;hyperedge&gt;&quot;The rerank provider is configured via the .env file. Below is an example configuration for a rerank model deployed locally using vLLM:&quot;&quot;" target="&quot;RERANK MODEL&quot;">
  <data key="d5">70.0</data>
  <data key="d6">chunk-44dde1b8fa9d74e9edbda4a6a1d22019</data>
</edge>

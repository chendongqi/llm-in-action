<edge source="&lt;hyperedge&gt;&quot;Community detection is a crucial step in understanding the organization of the graph, as it identifies communities of entities that are closely related.&quot;" target="&quot;ORGANIZATION &quot;">
  <data key="d5">90.0</data>
  <data key="d6">chunk-1510fdc0a4611e7ac84d55abc79e6e54</data>
</edge>
